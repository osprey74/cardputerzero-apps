# パッケージング定義。scripts/pack_deb.sh が source して .deb と APPLaunch 登録に使う。
PKG_NAME=cz-hello-fb
PKG_VERSION=0.1.0
PKG_REVISION=osprey74-1
PKG_DESC="CardputerZero standalone framebuffer app template (Rust)"
PKG_DEPENDS=""
APP_NAME="Hello FB"
APP_EXEC=/usr/share/APPLaunch/bin/cz-hello-fb
APP_TERMINAL=false
APP_ICON=share/images/cz-hello-fb.png
