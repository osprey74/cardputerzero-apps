# パッケージング定義。scripts/pack_deb.sh が source する。
PKG_NAME=cz-hello-sdl2
PKG_VERSION=0.1.0
PKG_REVISION=osprey74-1
PKG_DESC="CardputerZero standalone SDL2 app template (320x170, Rust)"
PKG_DEPENDS="libsdl2-2.0-0"
APP_NAME="Hello SDL2"
APP_EXEC=/usr/share/APPLaunch/bin/cz-hello-sdl2
APP_TERMINAL=false
APP_ICON=share/images/cz-hello-sdl2.png
