# App11 LAN Scanner パッケージング定義（Python・フレームバッファ UI。shared/fb_ui を同梱）。
# 依存は工場出荷イメージに導入済みのものだけ（2026-11-19 実機確認）。
PKG_NAME=lan-scanner
PKG_VERSION=0.1.1
PKG_REVISION=osprey74-1
PKG_DESC="App11 LAN scanner: host discovery (ICMP+ARP), mDNS/DNS names, OUI vendors and TCP port check on the connected subnet. Framebuffer UI, 320x170."
PKG_DEPENDS="python3, python3-pil, python3-numpy, iproute2"
APP_NAME="LAN Scanner"
APP_EXEC=/usr/share/APPLaunch/bin/lan-scanner
APP_TERMINAL=false
APP_ICON=share/images/lan-scanner.png