# App16 星座盤 パッケージング定義（ハイブリッド: フレームバッファ UI(Python) + Python サイドカー + カタログデータ）。
# CardputerZero の LCD は /dev/fb0 直描画（SDL/Wayland 不可・2026-11-17 実機調査）のため、
# 既定の UI は ui_fb/stellar_fb.py。依存は工場出荷イメージに導入済みのものだけにしている。
PKG_NAME=stellar-map
PKG_VERSION=0.1.3
PKG_REVISION=osprey74-1
PKG_DESC="App16 offline planetarium (star map). Python sidecar + framebuffer UI, 320x170."
PKG_DEPENDS="python3, python3-pil, python3-numpy"
APP_NAME="Stellar Map"
APP_EXEC=/usr/share/APPLaunch/bin/stellar-map
APP_TERMINAL=false
APP_ICON=share/images/stellar-map.png
