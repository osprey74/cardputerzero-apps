# App16 星座盤 パッケージング定義（ハイブリッド: SDL2 UI + Python サイドカー + カタログデータ）。
PKG_NAME=stellar-map
PKG_VERSION=0.1.0
PKG_REVISION=osprey74-1
PKG_DESC="App16 offline planetarium (star map). Python sidecar + SDL2 UI, 320x170."
PKG_DEPENDS="libsdl2-2.0-0, python3"
APP_NAME="Stellar Map"
APP_EXEC=/usr/share/APPLaunch/bin/stellar-map
APP_TERMINAL=false
APP_ICON=share/images/stellar-map.png
