# App07 Wi-Fi Analyzer パッケージング定義（Python・フレームバッファ UI。shared/fb_ui を同梱）。
# 依存は工場出荷イメージに導入済みのものだけ（2026-11-19 実機確認）。
PKG_NAME=wifi-analyzer
PKG_VERSION=0.1.1
PKG_REVISION=osprey74-1
PKG_DESC="App07 Wi-Fi analyzer: nearby AP list, 2.4GHz channel map and signal graph (nmcli, receive only). Framebuffer UI, 320x170."
PKG_DEPENDS="python3, python3-pil, python3-numpy, network-manager"
APP_NAME="Wi-Fi Analyzer"
APP_EXEC=/usr/share/APPLaunch/bin/wifi-analyzer
APP_TERMINAL=false
APP_ICON=share/images/wifi-analyzer.png