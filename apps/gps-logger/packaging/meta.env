# App01 GPS ロガー パッケージング定義（Python・フレームバッファ UI。shared/fb_ui と shared/gnss_at6668 を同梱）。
# 依存は工場出荷イメージに導入済みのものだけ。
PKG_NAME=gps-logger
PKG_VERSION=0.1.0
PKG_REVISION=osprey74-1
PKG_DESC="App01 GPS logger: GPX 1.1 track recording, speed/distance stats, sky plot and track view (Cap LoRa-1262 GPS or Grove GPS unit, receive only). Framebuffer UI, 320x170."
PKG_DEPENDS="python3, python3-pil, python3-numpy"
APP_NAME="GPS Logger"
APP_EXEC=/usr/share/APPLaunch/bin/gps-logger
APP_TERMINAL=false
APP_ICON=share/images/gps-logger.png