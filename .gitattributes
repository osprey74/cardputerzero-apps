# Linux 実機/デバイスへ配布・実行されるファイルは LF 固定（CRLF だと bash/sh が壊れる）
*.sh            text eol=lf
*.py            text eol=lf
*.rs            text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.env           text eol=lf

# 拡張子なしの Debian maintainer scripts（バス名一致・全ディレクトリ配下に適用）
postinst   text eol=lf
preinst    text eol=lf
prerm      text eol=lf
postrm     text eol=lf

# バイナリ扱い（改行変換しない）
*.png    binary
*.bsp    binary
*.bin    binary
*.deb    binary
*.gz     binary
