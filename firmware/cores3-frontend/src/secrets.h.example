// Wi-Fi 認証情報テンプレート。
//
//   このファイルを同じディレクトリに secrets.h としてコピーし、実値を記入する。
//   secrets.h は .gitignore 済みなのでコミットされない。
//
//   cp secrets.h.example secrets.h   (MSYS2 / bash)
//
// secrets.h が無い場合でもビルドは通る (main.cpp が __has_include で吸収し、
// AP が 1 つも無ければ Wi-Fi 機能を無効化して通常ダッシュボードのみ動作する)。

#pragma once

// ---- 複数 AP 登録 (推奨・新形式) -------------------------------------------
// X("SSID", "PASSWORD") を必要なだけ並べる。各行末に「\」(行継続) を付け、
// 最終行だけ「\」を付けない。起動時に登録し、電波の強い既知 AP へ自動接続する
// (自宅・スマホテザリング・職場などを並べておくと最適な AP に繋がる)。
#define WIFI_APS \
    X("home-2.4G", "home-password") \
    X("iPhone-hotspot", "hotspot-password") \
    X("office-2.4G", "office-password")

// ---- 単一 AP (旧形式・後方互換) --------------------------------------------
// WIFI_APS を使わない場合は、代わりに以下の 2 行のコメントを外して使う。
// #define WIFI_SSID "your-ssid-here"
// #define WIFI_PASS "your-password-here"
